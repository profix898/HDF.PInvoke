<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>HDF.PInvoke</RootNamespace>
    <AssemblyName>HDF.PInvoke</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>HDF.PInvoke.snk</AssemblyOriginatorKeyFile>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <Description>.NET 8 and .NET Standard 2.0 bindings for HDF5 2.2, with native libraries for Windows and Linux x64/ARM64 and macOS ARM64.</Description>
    <Authors>The HDF Group;HDF.PInvoke contributors</Authors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1574;CS1591</WarningsAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <RequiredNativeRids Condition="'$(RequiredNativeRids)' == ''">win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-arm64</RequiredNativeRids>
  </PropertyGroup>
  <ItemGroup>
    <ExcludedNativeRid Include="win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-arm64" Exclude="$([MSBuild]::Unescape('$(RequiredNativeRids)'))" />
    <NativeRuntime Include="../../Build/Native/runtimes/**/*" Exclude="../../Build/Native/runtimes/LICENSE.txt;../../Build/Native/runtimes/**/Licenses/**;@(ExcludedNativeRid->'../../Build/Native/runtimes/%(Identity)/**/*')" />
    <None Include="@(NativeRuntime)" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="RequireNativeRuntimes" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <RequiredNativeRid Include="$([MSBuild]::Unescape('$(RequiredNativeRids)'))" />
    </ItemGroup>
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../Build/Native/runtimes/%(RequiredNativeRid.Identity)/native/build-info.json')" Text="Missing verified runtime %(RequiredNativeRid.Identity). Build all required RIDs before packing." />
  </Target>
  <!-- NuGet's timestamp check otherwise misses changes to the selected RID/file set. -->
  <Target Name="TrackNativePackageInputs" BeforeTargets="_CalculateInputsOutputsForPack">
    <WriteLinesToFile File="$(IntermediateOutputPath)native-pack-inputs.txt" Lines="$([MSBuild]::Unescape('$(RequiredNativeRids)'));@(NativeRuntime)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <NuGetPackInput Include="$(IntermediateOutputPath)native-pack-inputs.txt" />
    </ItemGroup>
  </Target>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Interop/Legacy/**/*.cs" />
  </ItemGroup>
  <!-- The modern target compiles the declarations directly; only legacy treats them as generator inputs. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Interop/Modern/**/*.cs;HDF5/**/*.cs" />
    <AdditionalFiles Include="HDF5/**/*.cs" HdfBindingPath="HDF5/%(RecursiveDir)%(Filename)%(Extension)" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="HdfBindingPath" />
    <ProjectReference Include="../../Tools/BindingGenerator/BindingGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
</Project>
