<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefineConstants Condition="'$(HdfLegacy)' == 'true'">$(DefineConstants);HDF_LEGACY</DefineConstants>
    <HdfLegacy Condition="'$(HdfLegacy)' == ''">false</HdfLegacy>
    <TargetFramework Condition="'$(HdfTestFramework)' != ''">$(HdfTestFramework)</TargetFramework>
    <RootNamespace>UnitTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <NuGetLockFilePath>packages.$(TargetFramework).$(HdfLegacy).lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Sources/HDF.PInvoke/HDF.PInvoke.csproj">
      <SetTargetFramework Condition="'$(HdfLegacy)' == 'true'">TargetFramework=netstandard2.0</SetTargetFramework>
    </ProjectReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' Or '$(HdfTestFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
</Project>
