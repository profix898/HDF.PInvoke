cmake_minimum_required(VERSION 3.26)
# Initial cache for a standalone upstream HDF5 build.

file(READ "${CMAKE_CURRENT_LIST_DIR}/../Build/HDF5.props" dependency_props)
string(REGEX MATCH "<Hdf5Revision>([^<]+)</Hdf5Revision>" _ "${dependency_props}")
set(expected_hdf5_revision "${CMAKE_MATCH_1}")
string(REGEX MATCH "<ZlibRevision>([^<]+)</ZlibRevision>" _ "${dependency_props}")
set(zlib_revision "${CMAKE_MATCH_1}")
if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/hdf5/CMakeLists.txt")
  message(FATAL_ERROR "Initialize official sources with: git submodule update --init --recursive")
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_LIST_DIR}/hdf5" rev-parse HEAD
  OUTPUT_VARIABLE actual_hdf5_revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT actual_hdf5_revision STREQUAL expected_hdf5_revision)
  message(FATAL_ERROR "HDF5 checkout differs from Build/HDF5.props; update the gitlink and version metadata together.")
endif()

set(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE BOOL "" FORCE)
if(CMAKE_HOST_APPLE)
  set(CMAKE_INSTALL_RPATH "@loader_path" CACHE STRING "" FORCE)
elseif(CMAKE_HOST_UNIX)
  set(CMAKE_INSTALL_RPATH "$ORIGIN" CACHE STRING "" FORCE)
endif()
set(CMAKE_INSTALL_RPATH_USE_LINK_PATH OFF CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS ON CACHE BOOL "" FORCE)
set(BUILD_STATIC_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING ON CACHE BOOL "Run upstream tests before staging native libraries" FORCE)
set(HDF5_TEST_SERIAL ON CACHE BOOL "" FORCE)
set(HDF5_TEST_API ON CACHE BOOL "" FORCE)
set(HDF5_TEST_SWMR ON CACHE BOOL "" FORCE)
set(HDF_TEST_EXPRESS "1" CACHE STRING "Full upstream test iterations; use 0 for exhaustive stress" FORCE)
set(HDF5_BUILD_HL_LIB ON CACHE BOOL "" FORCE)
set(HDF5_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(HDF5_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(HDF5_BUILD_CPP_LIB OFF CACHE BOOL "" FORCE)
set(HDF5_BUILD_FORTRAN OFF CACHE BOOL "" FORCE)
set(HDF5_BUILD_JAVA OFF CACHE BOOL "" FORCE)
set(HDF5_ENABLE_PARALLEL OFF CACHE BOOL "" FORCE)
set(HDF5_ENABLE_THREADSAFE OFF CACHE BOOL "Upstream does not support HL plus thread safety" FORCE)
set(HDF5_ENABLE_CONCURRENCY OFF CACHE BOOL "" FORCE)
set(HDF5_ENABLE_DEPRECATED_SYMBOLS ON CACHE BOOL "Retain available compatibility exports" FORCE)
set(HDF5_ENABLE_ZLIB_SUPPORT ON CACHE BOOL "" FORCE)
set(HDF5_USE_ZLIB_STATIC ON CACHE BOOL "Avoid a separate zlib runtime dependency" FORCE)
set(ZLIB_USE_EXTERNAL ON CACHE BOOL "" FORCE)
set(HDF5_ALLOW_EXTERNAL_SUPPORT GIT CACHE STRING "" FORCE)
set(ZLIB_GIT_URL "https://github.com/HDFGroup/zlib.git" CACHE STRING "" FORCE)
set(ZLIB_GIT_TAG "${zlib_revision}" CACHE STRING "" FORCE)
set(HDF5_ENABLE_SZIP_SUPPORT OFF CACHE BOOL "Optional SZIP/libaec is not bundled" FORCE)
set(HDF5_ENABLE_ROS3_VFD OFF CACHE BOOL "" FORCE)
set(HDF5_ENABLE_HDFS OFF CACHE BOOL "" FORCE)
set(HDF5_INSTALL_LIB_DIR lib CACHE PATH "" FORCE)
set(HDF5_NO_PACKAGES ON CACHE BOOL "" FORCE)
