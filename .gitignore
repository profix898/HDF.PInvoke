# Managed/native compiler output and test results.
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Tt]est[Rr]esult*/
*.trx
*.nupkg
*.snupkg
*.log
*.tmp
*.cache
*.obj
*.pdb
*.ilk
*.pch
CMakeUserPresets.json

# Generated build trees; root Build contains versioned build tooling.
[Bb]uild/
!/Build/
/Build/*
!/Build/*.ps1
!/Build/*.sh
!/Build/*.props
!/Build/Alpine/
/Build/Alpine/*
!/Build/Alpine/alpine.sh
!/Build/Alpine/Alpine.Dockerfile

# Local IDE state and package caches.
.vs/
.idea/
.vscode/
_ReSharper*/
*.user
*.userosscache
*.suo
*.sln.docstates
*.DotSettings.user
packages/
node_modules/

# Local credentials, publishing settings and temporary files.
*.pfx
*.publishsettings
*.pubxml
*.userprefs
*~
~$*
.DS_Store
Thumbs.db
